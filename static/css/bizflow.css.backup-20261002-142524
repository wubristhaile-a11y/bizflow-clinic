/* =========================================================
   WUB TECH SOLUTIONS / BIZFLOW
   Shared Application Shell
   ========================================================= */

:root {
    --bf-primary: #2563eb;
    --bf-primary-dark: #1d4ed8;

    --bf-sidebar: #111827;
    --bf-sidebar-hover: #1f2937;
    --bf-sidebar-active: rgba(37, 99, 235, 0.22);

    --bf-bg: #f8fafc;
    --bf-card: #ffffff;
    --bf-border: #e5e7eb;

    --bf-text: #111827;
    --bf-text-muted: #6b7280;
    --bf-text-light: #94a3b8;

    --bf-success: #16a34a;
    --bf-warning: #d97706;
    --bf-danger: #dc2626;
    --bf-info: #0284c7;

    --bf-radius-sm: 8px;
    --bf-radius: 12px;
    --bf-radius-lg: 16px;

    --bf-shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
    --bf-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    --bf-shadow-lg: 0 10px 30px rgba(15, 23, 42, 0.08);

    --bf-sidebar-width: 250px;
    --bf-topbar-height: 64px;
}


/* =========================================================
   GLOBAL
   ========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
}

body {
    background: var(--bf-bg);
    color: var(--bf-text);
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
}

a {
    text-decoration: none;
}


/* =========================================================
   APPLICATION SHELL
   ========================================================= */

.bf-app {
    min-height: 100vh;
    background: var(--bf-bg);
}


/* =========================================================
   SIDEBAR
   ========================================================= */

.bf-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;

    width: var(--bf-sidebar-width);
    min-height: 100vh;

    display: flex;
    flex-direction: column;

    background: var(--bf-sidebar);
    color: #ffffff;

    z-index: 1000;

    overflow: hidden;
}


/* =========================================================
   SIDEBAR BRAND
   ========================================================= */

.bf-brand {
    min-height: var(--bf-topbar-height);

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 12px 18px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);

    flex-shrink: 0;
}

.bf-brand-mark {
    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: var(--bf-primary);
    color: #ffffff;

    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.03em;
}

.bf-brand-name {
    color: #ffffff;

    font-size: 0.98rem;
    font-weight: 700;

    line-height: 1.2;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bf-brand-product {
    color: var(--bf-text-light);

    font-size: 0.72rem;
    margin-top: 2px;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.bf-nav {
    flex: 1;

    padding: 18px 12px;

    overflow-y: auto;
    overflow-x: hidden;
}

.bf-nav::-webkit-scrollbar {
    width: 5px;
}

.bf-nav::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 10px;
}

.bf-nav-section {
    margin-bottom: 18px;
}

.bf-nav-section:last-child {
    margin-bottom: 0;
}

.bf-nav-label {
    color: #64748b;

    font-size: 0.68rem;
    font-weight: 700;

    letter-spacing: 0.08em;
    text-transform: uppercase;

    padding: 8px 10px 7px;
}

.bf-nav-link {
    display: flex;
    align-items: center;

    gap: 11px;

    width: 100%;

    color: #cbd5e1;

    padding: 10px 12px;
    margin: 2px 0;

    border-radius: 9px;

    font-size: 0.88rem;
    font-weight: 500;

    transition:
        background 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease;
}

.bf-nav-link:hover {
    background: var(--bf-sidebar-hover);
    color: #ffffff;
}

.bf-nav-link.active {
    background: var(--bf-sidebar-active);
    color: #ffffff;
    font-weight: 600;
}

.bf-nav-icon {
    width: 20px;
    min-width: 20px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    font-size: 1rem;

    opacity: 0.9;
}


/* =========================================================
   SIDEBAR FOOTER
   ========================================================= */

.bf-sidebar-footer {
    flex-shrink: 0;

    padding: 14px;

    border-top: 1px solid rgba(255, 255, 255, 0.08);
}


/* =========================================================
   MAIN AREA
   ========================================================= */

.bf-main {
    min-height: 100vh;

    margin-left: var(--bf-sidebar-width);

    background: var(--bf-bg);
}


/* =========================================================
   TOP BAR
   ========================================================= */

.bf-topbar {
    min-height: var(--bf-topbar-height);

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 28px;

    background: #ffffff;

    border-bottom: 1px solid var(--bf-border);

    position: sticky;
    top: 0;

    z-index: 900;
}

.bf-topbar-left {
    display: flex;
    align-items: center;

    min-width: 0;
}

.bf-topbar-title {
    color: var(--bf-text);

    font-size: 0.95rem;
    font-weight: 650;

    line-height: 1.2;
}

.bf-topbar-right {
    display: flex;
    align-items: center;

    gap: 12px;
}

.bf-user {
    display: flex;
    align-items: center;

    gap: 10px;
}

.bf-avatar {
    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 50%;

    background: #eff6ff;
    color: var(--bf-primary);

    font-size: 13px;
    font-weight: 700;
}


/* =========================================================
   PAGE CONTENT
   ========================================================= */

.bf-content {
    width: 100%;
    max-width: 1500px;

    margin: 0 auto;

    padding: 28px;
}


/* =========================================================
   ALERTS
   ========================================================= */

.bf-alert {
    padding: 12px 15px;

    margin-bottom: 18px;

    border-radius: var(--bf-radius-sm);

    border: 1px solid transparent;

    font-size: 0.88rem;
}

.bf-alert-success {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #166534;
}

.bf-alert-danger {
    background: #fef2f2;
    border-color: #fecaca;
    color: #991b1b;
}

.bf-alert-warning {
    background: #fffbeb;
    border-color: #fde68a;
    color: #92400e;
}

.bf-alert-info {
    background: #f0f9ff;
    border-color: #bae6fd;
    color: #075985;
}


/* =========================================================
   GENERIC CARDS
   ========================================================= */

.bf-card {
    background: var(--bf-card);

    border: 1px solid var(--bf-border);

    border-radius: var(--bf-radius);

    box-shadow: var(--bf-shadow-sm);

    overflow: hidden;
}

.bf-card-header {
    padding: 16px 18px;

    border-bottom: 1px solid var(--bf-border);

    font-weight: 600;
}

.bf-card-body {
    padding: 18px;
}


/* =========================================================
   PAGE HEADERS
   ========================================================= */

.bf-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 24px;
}

.bf-page-title {
    margin: 0;

    font-size: 1.35rem;
    font-weight: 700;

    color: var(--bf-text);
}

.bf-page-subtitle {
    margin: 5px 0 0;

    color: var(--bf-text-muted);

    font-size: 0.88rem;
}


/* =========================================================
   TABLES
   ========================================================= */

.bf-table {
    width: 100%;

    border-collapse: collapse;
}

.bf-table th {
    background: #f8fafc;

    color: #64748b;

    font-size: 0.72rem;
    font-weight: 700;

    letter-spacing: 0.04em;
    text-transform: uppercase;

    padding: 11px 13px;

    border-bottom: 1px solid var(--bf-border);

    text-align: left;
}

.bf-table td {
    padding: 12px 13px;

    border-bottom: 1px solid #eef2f7;

    font-size: 0.86rem;

    color: var(--bf-text);
}

.bf-table tr:last-child td {
    border-bottom: none;
}


/* =========================================================
   BUTTON HELPERS
   ========================================================= */

.bf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    padding: 9px 14px;

    border-radius: 8px;

    border: 1px solid transparent;

    font-size: 0.84rem;
    font-weight: 600;

    cursor: pointer;

    transition:
        background 0.15s ease,
        border-color 0.15s ease,
        transform 0.15s ease;
}

.bf-btn-primary {
    background: var(--bf-primary);
    color: #ffffff;
}

.bf-btn-primary:hover {
    background: var(--bf-primary-dark);
    color: #ffffff;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 991.98px) {

    .bf-sidebar {
        position: relative;

        width: 100%;
        min-height: auto;

        max-height: none;
    }

    .bf-nav {
        max-height: 420px;
    }

    .bf-main {
        margin-left: 0;
    }

    .bf-topbar {
        position: relative;

        padding: 0 20px;
    }

    .bf-content {
        padding: 20px;
    }

    .bf-page-header {
        flex-direction: column;
        align-items: flex-start;
    }
}


@media (max-width: 575.98px) {

    .bf-brand {
        padding: 12px 15px;
    }

    .bf-nav {
        padding: 14px 10px;
    }

    .bf-topbar {
        padding: 0 15px;
    }

    .bf-content {
        padding: 15px;
    }

    .bf-topbar-title {
        font-size: 0.88rem;
    }
}